# Get a Gemini key at https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=...

# --- Generic MCP support (server-side only, Gemini-only) ---
# JSON list of your own MCP servers. Keys never leave the server.
# This repo serves its own MCP at /api/mcp (see app/api/[transport]/route.ts).
# Local dev:
# MCP_SERVERS=[{"name":"local","url":"http://localhost:3000/api/mcp"}]
# On Vercel, point at your deployment:
# MCP_SERVERS=[{"name":"myserver","url":"https://your-app.vercel.app/api/mcp"}]
# MCP_ENABLED=true
