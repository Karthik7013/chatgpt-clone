# At least one provider key is needed to chat.

# OpenRouter - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Kilo Gateway - https://kilo.ai/settings/keys
KILO_API_KEY=

# NVIDIA NIM - https://build.nvidia.com/settings
NVIDIA_API_KEY=

# MongoDB - chat persistence (https://www.mongodb.com/docs/atlas/connect-to-mongodb/)
# Keep the real connection string in .env.local only (gitignored).
MONGODB_URI=
# Optional database name; used when the connection string has no database path.
MONGODB_DB=chatgpt-clone
